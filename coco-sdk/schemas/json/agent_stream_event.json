{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentStreamEvent",
  "description": "Agent-loop stream events. Higher-level than `coco_types::StreamEvent`\n(which represents raw LLM inference deltas). Adds:\n- Tool lifecycle states (Queued → Started → Completed)\n- MCP tool call tracking\n- Turn-scoped item IDs\n\nInput to `StreamAccumulator`.\nSee `event-system-design.md` Section 1.5.",
  "oneOf": [
    {
      "description": "Begin one provider response attempt within a logical turn. Text and\nthinking deltas remain provisional until the matching commit.",
      "type": "object",
      "properties": {
        "attempt": {
          "type": "integer",
          "format": "int32"
        },
        "turn_id": {
          "$ref": "#/$defs/TurnId"
        },
        "type": {
          "type": "string",
          "const": "response_attempt_started"
        }
      },
      "required": [
        "type",
        "turn_id",
        "attempt"
      ]
    },
    {
      "description": "Commit the provisional text/thinking deltas for an attempt.",
      "type": "object",
      "properties": {
        "attempt": {
          "type": "integer",
          "format": "int32"
        },
        "turn_id": {
          "$ref": "#/$defs/TurnId"
        },
        "type": {
          "type": "string",
          "const": "response_attempt_committed"
        }
      },
      "required": [
        "type",
        "turn_id",
        "attempt"
      ]
    },
    {
      "description": "Discard provisional deltas from a malformed attempt before retrying.",
      "type": "object",
      "properties": {
        "attempt": {
          "type": "integer",
          "format": "int32"
        },
        "turn_id": {
          "$ref": "#/$defs/TurnId"
        },
        "type": {
          "type": "string",
          "const": "response_attempt_discarded"
        }
      },
      "required": [
        "type",
        "turn_id",
        "attempt"
      ]
    },
    {
      "description": "Text content delta from assistant response.",
      "type": "object",
      "properties": {
        "delta": {
          "type": "string"
        },
        "turn_id": {
          "$ref": "#/$defs/TurnId"
        },
        "type": {
          "type": "string",
          "const": "text_delta"
        }
      },
      "required": [
        "type",
        "turn_id",
        "delta"
      ]
    },
    {
      "description": "Thinking/reasoning delta from extended thinking.",
      "type": "object",
      "properties": {
        "delta": {
          "type": "string"
        },
        "turn_id": {
          "$ref": "#/$defs/TurnId"
        },
        "type": {
          "type": "string",
          "const": "thinking_delta"
        }
      },
      "required": [
        "type",
        "turn_id",
        "delta"
      ]
    },
    {
      "description": "Tool use block received from API (input complete). Creates a ThreadItem.",
      "type": "object",
      "properties": {
        "call_id": {
          "type": "string"
        },
        "input": true,
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "tool_use_queued"
        }
      },
      "required": [
        "type",
        "call_id",
        "name",
        "input"
      ]
    },
    {
      "description": "Tool-owned structured interpretation of arguments while they stream.\nUnlike the TUI-only raw delta, this is a semantic SDK-visible update.",
      "type": "object",
      "properties": {
        "call_id": {
          "type": "string"
        },
        "file_changes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FileChangeInfo"
          }
        },
        "type": {
          "type": "string",
          "const": "tool_use_input_updated"
        }
      },
      "required": [
        "type",
        "call_id",
        "file_changes"
      ]
    },
    {
      "description": "Tool execution has begun (after permission check).",
      "type": "object",
      "properties": {
        "batch_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "call_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "tool_use_started"
        }
      },
      "required": [
        "type",
        "call_id",
        "name"
      ]
    },
    {
      "description": "Tool execution completed with result.\n\n`name` is carried here so StreamAccumulator and TUI consumers can\nreconstruct display state without maintaining their own call_id → name map.",
      "type": "object",
      "properties": {
        "call_id": {
          "type": "string"
        },
        "is_error": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "output": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "tool_use_completed"
        }
      },
      "required": [
        "type",
        "call_id",
        "name",
        "output",
        "is_error"
      ]
    },
    {
      "description": "MCP tool call initiated (separate from builtin tools).",
      "type": "object",
      "properties": {
        "call_id": {
          "type": "string"
        },
        "server": {
          "type": "string"
        },
        "tool": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "mcp_tool_call_begin"
        }
      },
      "required": [
        "type",
        "server",
        "tool",
        "call_id"
      ]
    },
    {
      "description": "MCP tool call completed.",
      "type": "object",
      "properties": {
        "call_id": {
          "type": "string"
        },
        "is_error": {
          "type": "boolean"
        },
        "server": {
          "type": "string"
        },
        "tool": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "mcp_tool_call_end"
        }
      },
      "required": [
        "type",
        "server",
        "tool",
        "call_id",
        "is_error"
      ]
    }
  ],
  "$defs": {
    "FileChangeInfo": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/FileChangeKind"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "kind"
      ]
    },
    "FileChangeKind": {
      "type": "string",
      "enum": [
        "create",
        "modify",
        "delete"
      ]
    },
    "TurnId": {
      "description": "Branded turn identifier. One per logical user-prompt cycle —\nshared between the paired `TurnStarted` and `TurnEnded` events.\nGenerated by the runner layer (`tui_runner` / `sdk_runner`),\nnot the engine, so pre-engine hook blocks still emit a complete\nlifecycle pair.",
      "type": "string"
    }
  }
}